# =============================================================================
# CONFIGURACIÓN DE POSTGRESQL
# =============================================================================
PG_HOST=warehouse
PG_PORT=5432
PG_DB=postgres
PG_USER=postgres
PG_PASSWORD=your_password_here
PG_SCHEMA_RAW=raw
PG_SCHEMA_ANALYTICS=analytics

# =============================================================================
# CONFIGURACIÓN DE INGESTA
# =============================================================================
# Años a procesar (separados por coma)
YEARS=2023,2024,2025

# Servicios de taxi (yellow,green)
SERVICES=yellow,green

# ID de ejecución (generado automáticamente si no se especifica)
RUN_ID=

# Base URL para descargar archivos Parquet
PARQUET_BASE_URL=https://d37ci6vzurychx.cloudfront.net/trip-data

# =============================================================================
# CONFIGURACIÓN DE OBT BUILDER
# =============================================================================
# Modo de construcción: full o by-partition
OBT_MODE=by-partition

# Rango de años para construir OBT
OBT_YEAR_START=2023
OBT_YEAR_END=2025

# Meses específicos (opcional, formato: 1,2,3 o 1-12)
OBT_MONTHS=

# Sobrescribir datos existentes (true/false)
OBT_OVERWRITE=false

# =============================================================================
# CONFIGURACIÓN DE JUPYTER/SPARK
# =============================================================================
JUPYTER_TOKEN=
SPARK_LOCAL_IP=0.0.0.0

# =============================================================================
# CONFIGURACIÓN DE PGADMIN
# =============================================================================
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin
